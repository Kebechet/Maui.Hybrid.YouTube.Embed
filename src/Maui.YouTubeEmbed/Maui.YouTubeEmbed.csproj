<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!-- One net10.0 assembly for every host. The loopback server is chosen at runtime on iOS and Mac Catalyst, so a
	     shared Razor library (a Blazor WebAssembly site and a MAUI app built from the same components) references this
	     package once. Shiny.Net.HttpServer needs .NET 10, which is why there are no older targets. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Kebechet.Maui.YouTubeEmbed</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Label="NugetProperties">
		<Authors>Kebechet</Authors>
		<IsPackable>true</IsPackable>
		<PackageId>Kebechet.Maui.YouTubeEmbed</PackageId>
		<Description>Plays YouTube videos inside a .NET MAUI Blazor Hybrid app without YouTube's Error 153 on iOS and Mac Catalyst, and without a proxy page on your own domain. One component and one URL provider for every platform.</Description>
		<RepositoryUrl>https://github.com/Kebechet/Maui.YouTubeEmbed</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Kebechet/Maui.YouTubeEmbed</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageIcon>icon.png</PackageIcon>
		<PackageTags>maui;blazor;blazorwebview;youtube;embed;iframe;ios;wkwebview;error153</PackageTags>
		<Version>1.0.0</Version>
		<PackageReleaseNotes>Initial release</PackageReleaseNotes>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DeterministicSourcePaths Condition="'$(GITHUB_ACTIONS)' == 'true'">true</DeterministicSourcePaths>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<!-- No Microsoft.SourceLink.GitHub reference: Source Link ships in the .NET SDK since 8.0, and the 8.0.0 package
	     brings Microsoft.Build.Tasks.Git 8.0.0 with a known vulnerability (NU1902). -->
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
		<PackageReference Include="Shiny.Net.HttpServer" Version="2.2.1" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Maui.YouTubeEmbed.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
