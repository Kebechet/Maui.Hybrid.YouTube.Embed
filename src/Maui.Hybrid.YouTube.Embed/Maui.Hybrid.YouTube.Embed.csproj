<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!-- The loopback server is needed only where MAUI's web views serve the app from app://0.0.0.1 (iOS, Mac Catalyst),
	     so it and Shiny.Net.HttpServer ship only in those builds. Every other host takes the net10.0 build, which hands
	     out YouTube's own embed URL: a shared Razor library (a Blazor WebAssembly site and a MAUI app built from the same
	     components) compiles against it once, and the iOS app picks the iOS build at restore. The public API must stay
	     the same in every build for that to work. Deliberately no UseMaui: the net10.0 build would carry MAUI into
	     WebAssembly. Shiny.Net.HttpServer needs .NET 10, which is why there are no older targets. -->
	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<RootNamespace>Kebechet.Maui.Hybrid.YouTube.Embed</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>
		<ServesLocalEmbedPage Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">true</ServesLocalEmbedPage>
	</PropertyGroup>

	<PropertyGroup Label="NugetProperties">
		<Authors>Kebechet</Authors>
		<IsPackable>true</IsPackable>
		<PackageId>Kebechet.Maui.Hybrid.YouTube.Embed</PackageId>
		<Description>Plays YouTube videos inside .NET MAUI hybrid apps (BlazorWebView, HybridWebView) without YouTube's Error 153 on iOS and Mac Catalyst, and without a proxy page on your own domain. Everywhere else it hands out YouTube's own embed URL, so a Razor library shared with a website references it too.</Description>
		<RepositoryUrl>https://github.com/Kebechet/Maui.Hybrid.YouTube.Embed</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Kebechet/Maui.Hybrid.YouTube.Embed</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageIcon>icon.png</PackageIcon>
		<PackageTags>maui;hybrid;blazor;blazorwebview;hybridwebview;youtube;embed;iframe;ios;wkwebview;error153</PackageTags>
		<Version>1.0.0</Version>
		<PackageReleaseNotes>Initial release: YouTube in MAUI's BlazorWebView and HybridWebView without Error 153 on iOS and Mac Catalyst, a Blazor component, and YouTubeLink.TryParse for the links YouTube hands out.</PackageReleaseNotes>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DeterministicSourcePaths Condition="'$(GITHUB_ACTIONS)' == 'true'">true</DeterministicSourcePaths>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<!-- No Microsoft.SourceLink.GitHub reference: Source Link ships in the .NET SDK since 8.0, and the 8.0.0 package
	     brings Microsoft.Build.Tasks.Git 8.0.0 with a known vulnerability (NU1902). -->
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(ServesLocalEmbedPage)' == 'true'">
		<PackageReference Include="Shiny.Net.HttpServer" Version="2.2.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(ServesLocalEmbedPage)' != 'true'">
		<Compile Remove="LocalServerYouTubeEmbedUrlProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Maui.Hybrid.YouTube.Embed.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
